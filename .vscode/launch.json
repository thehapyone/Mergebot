{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        },
        {
            "name": "Run Mergebot app.py (CLI)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/mergebot/app.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "args": ["cli", "--mr-url", "https://gitlab.its.getingecloud.net/dts/lestrade/aide-recorder/-/merge_requests/71"]
        },
        {
            "name": "Run Mergebot app.py (ondemand)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/mergebot/app.py",
            "console": "integratedTerminal",
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false,
            "args": ["ondemand"]
        }
    ]
}
