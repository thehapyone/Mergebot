name: Mergebot PR Analysis

on:
  pull_request:
    types: [opened, synchronize, reopened]
  workflow_dispatch: # Allow manual trigger
  # schedule:          # Uncomment to enable scheduled runs (e.g., scan all open PRs every night)
  #   - cron: '0 3 * * *'

jobs:
  mergebot:
    name: Run Mergebot on PR
    runs-on: ubuntu-latest

    env:
      # Required GitHub App credentials (add these as repository or org secrets!)
      GITHUB_APP_ID: ${{ secrets.GITHUB_APP_ID }}
      GITHUB_APP_PRIVATE_KEY: ${{ secrets.GITHUB_APP_PRIVATE_KEY }}
      # Optional: Only set if App auto-discovery fails
      # GITHUB_APP_INSTALLATION_ID: ${{ secrets.GITHUB_APP_INSTALLATION_ID }}

      # Pass LLM credentials as needed (e.g., for Azure/OpenAI)
      # AZURE_API_KEY: ${{ secrets.AZURE_API_KEY }}
      # AZURE_API_BASE: ${{ secrets.AZURE_API_BASE }}
      # AZURE_API_VERSION: ${{ secrets.AZURE_API_VERSION }}

      # Optional: Path to config (if not using default, e.g., config-github.yaml)
      # CONFIG_PATH: ${{ github.workspace }}/config-github.yaml

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Pull Mergebot Docker image
        run: docker pull thehapyone/mergebot:latest

      - name: Run Mergebot on the PRs
        run: |
          docker run --rm \
            -e GITHUB_APP_ID \
            -e GITHUB_APP_PRIVATE_KEY \
            # -e GITHUB_APP_INSTALLATION_ID \  # Uncomment if you use this
            # -e AZURE_API_KEY \
            # -e AZURE_API_BASE \
            # -e AZURE_API_VERSION \
            -v "${{ github.workspace }}:/repo" \
            -w /repo \
            thehapyone/mergebot:latest \
              mergebot ondemand --project="${{ github.repository }}"
        # Feel free to add --workers=<n> or --config if your setup requires it

# NOTES:
# - Provide required secrets in your repo/organization: GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY (multiline PEM!).
# - If your config lives in a different location or you support multiple configs, set CONFIG_PATH above.
# - By default, this runs when a PR is opened, synced, or reopened.
# - For scheduled runs, add the schedule trigger and optionally modify the entrypoint (see docs).
# - For multi-repo or multi-param batch use, extend this workflow with a matrix or custom logic.

# For full documentation and advanced usage, see: docs/operations/github_actions.md (add this doc for parity)
